{
  "name": "@zandermax/web-components",
  "version": "1.0.0",
  "description": "Zander's custom web components",
  "author": "Zander Maxwell <zandermaxwell@hey.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/dial-selector.cjs",
  "module": "dist/dial-selector.js",
  "browser": "dist/dial-selector.umd.js",
  "exports": {
    ".": {
      "import": "./dist/dial-selector.js",
      "require": "./dist/dial-selector.cjs",
      "browser": "./dist/dial-selector.umd.js"
    },
    "./dial-selector": {
      "import": "./dist/dial-selector.js",
      "require": "./dist/dial-selector.cjs",
      "browser": "./dist/dial-selector.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "serve": "browser-sync start --server --port 3000 --startPath /examples/ --files dist",
    "dev": "concurrently \"npm:watch\" \"npm:serve\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.1",
    "rollup": "^4.53.3"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "dial-selector",
    "ui-components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zandermax/web-components.git"
  },
  "bugs": {
    "url": "https://github.com/zandermax/web-components/issues"
  },
  "homepage": "https://github.com/zandermax/web-components#readme"
}
